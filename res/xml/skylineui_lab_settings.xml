<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/skylineui_lab_title">

    <com.android.settingslib.widget.FooterPreference
        android:title="@string/skylineui_lab_footer"
        android:selectable="false"
        settings:searchable="false"/>
        
    <PreferenceCategory 
         android:title="Spoofing">
                
<!-- Unlimited google photos storage -->
    <SwitchPreference
        android:key="use_photos_spoof"
        android:icon="@drawable/ic_backup"
        android:title="@string/use_photos_spoof_title"
        android:summary="@string/use_photos_spoof_summary"
        android:defaultValue="true" />
    </PreferenceCategory>
    
     <PreferenceCategory 
         android:title="System">     
       <!-- Compact heads up -->
        <com.skylineui.settings.SystemPropertySwitchPreference
            android:key="persist.sys.compact_heads_up_notification.always_show"
            android:defaultValue="false"
            android:title="@string/compact_heads_up_notifications_enabled_title"
            android:summary="@string/compact_heads_up_notifications_enabled_summary" /> 
            
        <!-- Volume Styles -->      
        <com.skylineui.settings.SystemSettingListPreference
             android:key="custom_volume_styles"
             android:title="@string/volume_style_title"
             android:icon="@drawable/ic_settings_sound"
             android:entries="@array/volume_styles_entries"
             android:entryValues="@array/volume_styles_values"
             android:summary="%s"
             android:defaultValue="2" />
        </PreferenceCategory>
        
     <PreferenceCategory 
         android:title="Quick Settings">
          <!-- QS dual-tone -->
         <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_dual_tone"
            android:icon="@drawable/ic_color_bucket"
            android:title="@string/qs_dual_tone_title"
            android:summary="@string/qs_dual_tone_summary"
            android:defaultValue="true" />     
            
        <!-- back styles -->
            <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="back_gesture_style_classic"
            android:title="@string/back_gesture_style_classic_title"
            android:summary="@string/back_gesture_style_classic_summary"
            android:defaultValue="false"
            settings:controller="com.android.settings.gestures.BackGestureStylePreferenceController"  
            app:position="solo" />             
        </PreferenceCategory>
</PreferenceScreen>
